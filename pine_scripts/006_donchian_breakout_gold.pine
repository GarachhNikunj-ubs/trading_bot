// Strategy 06: Donchian Channel Breakout (Turtle Trading Model)
// #1 Most Profitable Strategy on Gold (XAUUSD / GC=F)
//@version=6
strategy("Algo 06: Donchian Breakout", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.03, slippage=1)

entryHigh = ta.highest(high[1], 20)
entryLow = ta.lowest(low[1], 20)
exitHigh = ta.highest(high[1], 10)
exitLow = ta.lowest(low[1], 10)

if close > entryHigh
    strategy.entry("Long", strategy.long)

if close < entryLow
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and close < exitLow
    strategy.close("Long")

if strategy.position_size < 0 and close > exitHigh
    strategy.close("Short")
