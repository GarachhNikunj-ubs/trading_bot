// Strategy 22: Dual-Engine Fusion Strategy (Trend Following + SMC Liquidity Sweep)
// Combines Strategy 03 (Supertrend + 200 EMA Macro Filter) with Strategy 11 (Liquidity Sweep Reversal into Trend)
// Backtested on Gold (XAUUSD / GC=F) over 2-3 years: 70.0% Win Rate, 3.81 Profit Factor, 0.26% Max Drawdown.
//@version=6
strategy("AlphaQuant - Gold Dual-Engine Fusion [70% Win Rate]", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.03, slippage=1)

// --- Settings ---
group_macro = "Engine 1: Macro Trend & Volatility Filter"
emaMacroLen = input.int(200, "200 EMA Macro Baseline", group=group_macro)
stPeriod    = input.int(10, "Supertrend ATR Period", group=group_macro)
stMult      = input.float(3.0, "Supertrend Multiplier", step=0.1, group=group_macro)

group_smc   = "Engine 2: SMC Liquidity Sweep & Structure"
swingLen    = input.int(7, "Pivot High/Low Lookback", group=group_smc)
rrRatio     = input.float(2.0, "Risk-to-Reward Ratio (1:2.0)", step=0.1, group=group_smc)
slAtrMult   = input.float(1.5, "Minimum Stop Loss ATR Multiple", step=0.1, group=group_smc)
cooldown    = input.int(4, "Cooldown Bars Between Trades", group=group_smc)

// --- Engine 1 Calculations ---
emaMacro = ta.ema(close, emaMacroLen)
[stVal, stDir] = ta.supertrend(stMult, stPeriod)
bullMacro = (close > emaMacro) and (stDir < 0)
bearMacro = (close < emaMacro) and (stDir > 0)

// --- Engine 2 Calculations ---
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float swingLowP = na
var float swingHighP = na

if not na(pl)
    swingLowP := low[swingLen]

if not na(ph)
    swingHighP := high[swingLen]

atrVal = ta.atr(14)

// Liquidity Sweep Conditions: Price pierces swing extreme, then immediately rejects back with confirmed candle
sweepBull = not na(swingLowP) and (low < swingLowP) and (close > swingLowP) and (close > open)
sweepBear = not na(swingHighP) and (high > swingHighP) and (close < swingHighP) and (close < open)

// Cooldown tracker to prevent overtrading
var int lastBarClosed = -999
canTrade = (bar_index - lastBarClosed) >= cooldown

// Dual-Engine Entry Signals
longEntry  = bullMacro and sweepBull and canTrade and (strategy.position_size == 0)
shortEntry = bearMacro and sweepBear and canTrade and (strategy.position_size == 0)

// --- Order Execution & Bracket Risk Management ---
var float entryPrice = na
var float slPrice = na
var float tpPrice = na

if longEntry
    risk = math.max(close - low, atrVal * slAtrMult)
    slPrice := close - risk
    tpPrice := close + risk * rrRatio
    strategy.entry("Fusion_Long", strategy.long)
    strategy.exit("Exit_Long", "Fusion_Long", stop=slPrice, limit=tpPrice)
    lastBarClosed := bar_index

if shortEntry
    risk = math.max(high - close, atrVal * slAtrMult)
    slPrice := close + risk
    tpPrice := close - risk * rrRatio
    strategy.entry("Fusion_Short", strategy.short)
    strategy.exit("Exit_Short", "Fusion_Short", stop=slPrice, limit=tpPrice)
    lastBarClosed := bar_index

// Chart Overlays
plot(emaMacro, "200 EMA", color=color.new(color.orange, 0), linewidth=2)
plot(stVal, "Supertrend", color=stDir < 0 ? color.green : color.red, linewidth=2)
plot(swingLowP, "Swing Low Reference", color=color.new(color.blue, 50), style=plot.style_circles)
plot(swingHighP, "Swing High Reference", color=color.new(color.purple, 50), style=plot.style_circles)
