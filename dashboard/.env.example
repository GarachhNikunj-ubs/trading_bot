# ==============================================================================
# ALPHAQUANT TRADING BOT & DASHBOARD CONFIGURATION TEMPLATE
# Copy this file to .env and dashboard/.env to configure credentials:
#   cp .env.example .env
#   cp .env.example dashboard/.env
# ==============================================================================

# Supabase Cloud Project Configuration (Replace with your Supabase Project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# Vite Frontend Aliases
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# Webhook Authentication Secret for TradingView Alerts
WEBHOOK_SECRET=your_secure_webhook_secret_key

# Python Bridge Port
BRIDGE_PORT=5001
